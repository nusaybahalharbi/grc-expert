{
  "version": 2,
  "functions": {
    "api/chat.js": { "maxDuration": 60 },
    "api/invite.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/data/kb.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" },
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
